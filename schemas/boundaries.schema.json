{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "Feature"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "properties": {
            "type": "object",
            "properties": {
              "iso": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "iso",
              "name"
            ],
            "additionalProperties": false
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "const": "MultiPolygon"
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    },
                    "minItems": 4
                  },
                  "minItems": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "type",
              "coordinates"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "id",
          "properties",
          "geometry"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "type",
    "features"
  ],
  "additionalProperties": false
}
