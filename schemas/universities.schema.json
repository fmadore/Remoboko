{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "Feature"
          },
          "properties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "country": {
                "enum": [
                  "Benin",
                  "Togo"
                ]
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "logo": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "name",
              "country",
              "city",
              "logo"
            ],
            "additionalProperties": false
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "const": "Point"
              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "type",
              "coordinates"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "properties",
          "geometry"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "type",
    "features"
  ],
  "additionalProperties": false
}
